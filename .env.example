# Supabase Config
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_anon_or_service_key_here
SUPABASE_SERVICE_ROLE_KEY=

# Production security
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
FRONTEND_URL=
FORCE_HTTPS=false
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
SESSION_MAX_AGE_SECONDS=3600
MAX_REQUEST_BYTES=10485760
MAX_UPLOAD_BYTES=8388608
TRUST_PROXY_HEADERS=false
REDIS_URL=
# Admin access must also be backed by app_metadata.role=admin in Supabase.
ADMIN_EMAILS=
REQUIRE_ADMIN_MFA=true

# AI providers (at least one is required for AI features)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Persistent medical-document storage
SUPABASE_MEDICAL_BUCKET=FitBreak Medical Knowledge

