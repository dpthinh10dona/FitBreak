# Supabase Config
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_anon_or_service_key_here
SUPABASE_SERVICE_ROLE_KEY=

# Production security
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
FRONTEND_URL=
FORCE_HTTPS=false
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
SESSION_MAX_AGE_SECONDS=3600
MAX_REQUEST_BYTES=10485760
MAX_UPLOAD_BYTES=8388608
TRUST_PROXY_HEADERS=false
REDIS_URL=
# Admin access must also be backed by app_metadata.role=admin in Supabase.
ADMIN_EMAILS=
REQUIRE_ADMIN_MFA=true

# AI providers (at least one is required for AI features)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Persistent medical-document storage
SUPABASE_MEDICAL_BUCKET=FitBreak Medical Knowledge

# Opt-in live RAG evaluation. Keep the secret on the server and evaluation runner.
FITBREAK_LIVE_EVAL_ENABLED=false
FITBREAK_LIVE_EVAL_SECRET=
# Set true only for a local React screenshot of Gemini -> Groq failover.
FITBREAK_EVAL_FORCE_GEMINI_FAILURE=false
# Runner only: existing test user's JWT, or FITBREAK_EVAL_EMAIL/PASSWORD.
FITBREAK_EVAL_API_URL=http://127.0.0.1:8000
FITBREAK_EVAL_BEARER_TOKEN=
FITBREAK_EVAL_EMAIL=
FITBREAK_EVAL_PASSWORD=

