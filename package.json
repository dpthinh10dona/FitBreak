{
  "name": "fitbreak",
  "version": "1.0.0",
  "description": "FitBreak",
  "scripts": {
    "build": "npm --prefix frontend ci && npm --prefix frontend run build",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:frontend\"",
    "dev:api": "uvicorn api.app.main:app --reload --port 8000",
    "dev:frontend": "npm --prefix frontend run dev",
    "start": "uvicorn api.app.main:app --host 0.0.0.0 --port 8000"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "live-server": "^1.2.2"
  }
}
